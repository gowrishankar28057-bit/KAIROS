# Google sign-in is OPTIONAL. Without these three, the site runs as a public demo.
# Generate AUTH_SECRET with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: require sign-in for the whole site
# AUTH_REQUIRED=true
# Optional: restrict who may sign in (comma-separated)
# AUTH_ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com
# AUTH_ALLOWED_DOMAINS=university.edu
